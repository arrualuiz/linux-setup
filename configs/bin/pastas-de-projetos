#!/usr/bin/env bash
# Monta na área de trabalho as pastas "Últimos projetos" e "Faculdade", com um atalho por projeto ou matéria, e os
# atalhos dos sites. Cada atalho de projeto abre o VS Code na pasta e o Claude com a frase de retomar (via abrir-projeto).
#   Últimos projetos: repositórios do ~/dev com commit desde a data (padrão 01/09/2026) ou com arquivo sem commit,
#                     do mais recente pro mais antigo.
#   Faculdade:        as matérias do último período da PUCPR, a UFPR e as pastas com os arquivos.
#   Sites:            soltos na área de trabalho, os sites que eu fiz (a tabela do SITES.md do caderno): um atalho
#                     que abre cada site e um que abre o VS Code + Claude em cada projeto.
# Rodar de novo atualiza tudo, sem mexer na posição dos atalhos de site. Uso: pastas-de-projetos [AAAA-MM-DD]
desde="${1:-2026-09-01}"
D="$(xdg-user-dir DESKTOP)"

# atalho ARQUIVO NOME PASTA FRASE [DATA]
atalho() {
  cat > "$1" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$2
Comment=Abre o VS Code em $3 e o Claude com a frase de retomar
Exec=$HOME/.local/bin/abrir-projeto $3 "$4"
Icon=vscode
Terminal=false
StartupNotify=false
EOF
  chmod +x "$1"
  gio set "$1" metadata::trusted true 2>/dev/null
  [ -n "$5" ] && touch -d "$5" "$1"
}

# Pasta na área de trabalho, com os atalhos antigos apagados e a ordem pela data de modificação.
pasta() {
  [ -L "$1" ] && rm "$1"   # era um link (o antigo "Faculdade" apontava pra pucpr/ads)
  mkdir -p "$1"
  find "$1" -maxdepth 1 -name '*.desktop' -delete
  gio set "$1" metadata::nemo-icon-view-sort-by modification_date 2>/dev/null
  gio set "$1" metadata::nemo-icon-view-sort-reversed true 2>/dev/null
  gio set "$1" metadata::nemo-list-view-sort-column date_modified 2>/dev/null
  gio set "$1" metadata::nemo-list-view-sort-reversed true 2>/dev/null
}

P="$D/Últimos projetos"
pasta "$P"
for g in ~/dev/*/.git ~/dev/projetos/*/.git; do
  repo=${g%/.git}; nome=$(basename "$repo")
  if [ -n "$(git -C "$repo" log -1 --since="$desde" --format=%h 2>/dev/null)" ] || [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
    atalho "$P/$nome.desktop" "$nome" "$repo" "Vamos continuar o projeto $nome." "$(git -C "$repo" log -1 --format=%cI)"
  fi
done

F="$D/Faculdade"
pasta "$F"
ads=~/dev/faculdade/pucpr/ads
periodo=$(ls -d $ads/*-periodo 2>/dev/null | sort -V | tail -1)
for m in "$periodo"/*/; do
  m=${m%/}; rev=$(ls "$m"/revisao-*.md 2>/dev/null | head -1)
  # Nome da matéria = título do revisao-*.md ("# Métodos Ágeis em TI — Treinamento"), senão o nome da pasta.
  nome=$( [ -n "$rev" ] && head -1 "$rev" | sed 's/^# *//; s/ — .*//' )
  [ -z "$nome" ] && nome=$(basename "$m")
  p=$(basename "$periodo")
  atalho "$F/pucpr-$(basename "$m").desktop" "$nome (PUCPR)" "$ads" \
    "Vamos estudar $nome (PUCPR, ${p%%-*}º período): segue o instrucoes-revisao.md e a pasta ${m#$ads/}."
done
ufpr=~/dev/faculdade/ufpr/estatistica
[ -d "$ufpr" ] && atalho "$F/ufpr.desktop" "Estatística (UFPR)" "$ufpr" \
  "Vamos estudar para a UFPR (Estatística e Ciência de Dados): segue o instrucoes-estudo.md."
ln -sfn "$ads" "$F/Arquivos PUCPR"
ln -sfn ~/dev/faculdade/ufpr "$F/Arquivos UFPR"

# Sites: cada linha da tabela "## Sites" do SITES.md do caderno vira um atalho que abre o endereço no navegador padrão
# ("Casamento - site"), e cada pasta de projeto vira um "Casamento - trabalhar (VS Code)", com o VS Code e o Claude.
# A lista fica no caderno (repositório privado) porque alguns endereços não são públicos. Sem o arquivo, nada muda.
# Eles ficam soltos na área de trabalho (não numa pasta) pra eu arrumar onde quiser, no segundo monitor. Por isso o
# atalho é reescrito no mesmo arquivo, nunca apagado e criado de novo: a posição que eu escolhi fica presa ao arquivo.
# Só sai o atalho de site que não está mais na tabela; os daqui têm a linha X-Sites=1, então nada meu é apagado.
lista=~/dev/projetos/rascunhos-e-anotacoes/SITES.md
n_sites=0
if [ -f "$lista" ]; then
  # 16/11 à tarde eles ficaram numa pasta "Sites": sai a pasta (só se não sobrar nada além dos atalhos daqui)
  if [ -d "$D/Sites" ]; then find "$D/Sites" -maxdepth 1 -name '*.desktop' -delete; rmdir "$D/Sites" 2>/dev/null; fi
  declare -A trabalhar=() feitos=()
  # marcar ARQUIVO: deixa o atalho confiável (sem o aviso do Nemo) e com a marca dos atalhos de site
  marcar() { echo 'X-Sites=1' >> "$1"; chmod +x "$1"; gio set "$1" metadata::trusted true 2>/dev/null; feitos["$1"]=1; }
  # o ícone (coluna Ícone) é o mesmo nos dois atalhos do projeto, como nos atalhos antigos (Casamento, Financeiro…)
  while IFS=$'\t' read -r projeto rotulo url dir icone; do
    [ -z "$url" ] && continue
    icone=${icone:-web-browser}
    dir=${dir/#\~/$HOME}
    arq="$D/$projeto - $rotulo.desktop"
    # o endereço vai entre aspas: o "#" do "#tarefas" é reservado no Exec de um .desktop
    cat > "$arq" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$projeto - $rotulo
Comment=Abre $url
Exec=xdg-open "$url"
Icon=$icone
Terminal=false
StartupNotify=false
EOF
    marcar "$arq"
    if [ -d "$dir" ] && [ -z "${trabalhar[$dir]}" ]; then
      arq="$D/$projeto - trabalhar (VS Code).desktop"
      atalho "$arq" "$projeto - trabalhar (VS Code)" "$dir" "Vamos continuar o projeto $projeto ($(basename "$dir"))."
      sed -i "s/^Icon=.*/Icon=$icone/" "$arq"
      marcar "$arq"
      trabalhar[$dir]=1
    fi
  done < <(awk -F'|' '
    /^## / { dentro = ($0 ~ /^## Sites/); next }
    dentro && /^\|/ && $2 !~ /^ *(Projeto|-+) *$/ {
      for (i = 2; i <= 6; i++) gsub(/^ +| +$/, "", $i)
      print $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6
    }' "$lista")
  for f in "$D"/*.desktop; do
    grep -qx 'X-Sites=1' "$f" 2>/dev/null && [ -z "${feitos[$f]}" ] && rm -f "$f"
  done
  n_sites=${#feitos[@]}
fi

echo "Últimos projetos: $(ls "$P"/*.desktop | wc -l) · Faculdade: $(ls "$F"/*.desktop | wc -l) matérias · Sites: $n_sites atalhos na área de trabalho"
