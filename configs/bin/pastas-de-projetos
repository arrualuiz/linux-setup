#!/usr/bin/env bash
# Monta na área de trabalho as pastas "Últimos projetos" e "Faculdade", com um atalho por projeto ou matéria.
# Cada atalho abre o VS Code na pasta e o Claude com a frase de retomar (via abrir-projeto).
#   Últimos projetos: repositórios do ~/dev com commit desde a data (padrão 01/09/2026) ou com arquivo sem commit,
#                     do mais recente pro mais antigo.
#   Faculdade:        as matérias do último período da PUCPR, a UFPR e as pastas com os arquivos.
# Rodar de novo atualiza as duas. Uso: pastas-de-projetos [AAAA-MM-DD]
desde="${1:-2026-09-01}"
D="$(xdg-user-dir DESKTOP)"

# atalho ARQUIVO NOME PASTA FRASE [DATA]
atalho() {
  cat > "$1" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$2
Comment=Abre o VS Code em $3 e o Claude com a frase de retomar
Exec=$HOME/.local/bin/abrir-projeto $3 "$4"
Icon=vscode
Terminal=false
StartupNotify=false
EOF
  chmod +x "$1"
  gio set "$1" metadata::trusted true 2>/dev/null
  [ -n "$5" ] && touch -d "$5" "$1"
}

# Pasta na área de trabalho, com os atalhos antigos apagados e a ordem pela data de modificação.
pasta() {
  [ -L "$1" ] && rm "$1"   # era um link (o antigo "Faculdade" apontava pra pucpr/ads)
  mkdir -p "$1"
  find "$1" -maxdepth 1 -name '*.desktop' -delete
  gio set "$1" metadata::nemo-icon-view-sort-by modification_date 2>/dev/null
  gio set "$1" metadata::nemo-icon-view-sort-reversed true 2>/dev/null
  gio set "$1" metadata::nemo-list-view-sort-column date_modified 2>/dev/null
  gio set "$1" metadata::nemo-list-view-sort-reversed true 2>/dev/null
}

P="$D/Últimos projetos"
pasta "$P"
for g in ~/dev/*/.git ~/dev/projetos/*/.git; do
  repo=${g%/.git}; nome=$(basename "$repo")
  if [ -n "$(git -C "$repo" log -1 --since="$desde" --format=%h 2>/dev/null)" ] || [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
    atalho "$P/$nome.desktop" "$nome" "$repo" "Vamos continuar o projeto $nome." "$(git -C "$repo" log -1 --format=%cI)"
  fi
done

F="$D/Faculdade"
pasta "$F"
ads=~/dev/faculdade/pucpr/ads
periodo=$(ls -d $ads/*-periodo 2>/dev/null | sort -V | tail -1)
for m in "$periodo"/*/; do
  m=${m%/}; rev=$(ls "$m"/revisao-*.md 2>/dev/null | head -1)
  # Nome da matéria = título do revisao-*.md ("# Métodos Ágeis em TI — Treinamento"), senão o nome da pasta.
  nome=$( [ -n "$rev" ] && head -1 "$rev" | sed 's/^# *//; s/ — .*//' )
  [ -z "$nome" ] && nome=$(basename "$m")
  p=$(basename "$periodo")
  atalho "$F/pucpr-$(basename "$m").desktop" "$nome (PUCPR)" "$ads" \
    "Vamos estudar $nome (PUCPR, ${p%%-*}º período): segue o instrucoes-revisao.md e a pasta ${m#$ads/}."
done
ufpr=~/dev/faculdade/ufpr/estatistica
[ -d "$ufpr" ] && atalho "$F/ufpr.desktop" "Estatística (UFPR)" "$ufpr" \
  "Vamos estudar para a UFPR (Estatística e Ciência de Dados): segue o instrucoes-estudo.md."
ln -sfn "$ads" "$F/Arquivos PUCPR"
ln -sfn ~/dev/faculdade/ufpr "$F/Arquivos UFPR"

echo "Últimos projetos: $(ls "$P"/*.desktop | wc -l) · Faculdade: $(ls "$F"/*.desktop | wc -l) matérias"
