#!/usr/bin/env python3
# Vigia de temperatura: meu gabinete é pequeno e a RTX 2060 esquenta tudo lá dentro.
# A cada 30 s grava processador e placa de vídeo em ~/.local/share/vigia-temperatura/AAAA-MM.csv
# e avisa na tela quando passa do limite. No pico (crítico) também toca um alarme, porque em jogo de tela
# cheia o aviso pode não aparecer. Quem roda é o vigia-temperatura.service (systemd do usuário).
import csv, glob, subprocess, time
from datetime import datetime
from pathlib import Path

INTERVALO = 30
PASTA = Path.home() / '.local/share/vigia-temperatura'
# (atenção, crítico) em °C. O sensor do Xeon marca 85 como crítico. A RTX 2060 mira 83, tem máximo de
# operação em 88, perde velocidade em 90 e desliga em 93 (nvidia-smi -q -d TEMPERATURE).
LIMITES = {'Processador': (75, 82), 'Placa de vídeo': (80, 85)}
FOLGA = 5  # só avisa de novo depois de esfriar isso abaixo do limite
ALARME = '/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga'
COLUNAS = ['quando', 'processador_c', 'placa_c', 'ventoinha_pct', 'watts', 'uso_pct']

nivel = dict.fromkeys(LIMITES, 0)


def temp_processador():
    for nome in glob.glob('/sys/class/hwmon/hwmon*/name'):
        if Path(nome).read_text().strip() == 'coretemp':
            return int((Path(nome).parent / 'temp1_input').read_text()) // 1000
    return None


def dados_placa():
    """Temperatura, ventoinha, consumo e uso. Sem o driver da NVIDIA, volta tudo vazio."""
    consulta = 'temperature.gpu,fan.speed,power.draw,utilization.gpu'
    try:
        r = subprocess.run(['nvidia-smi', f'--query-gpu={consulta}', '--format=csv,noheader,nounits'],
                           capture_output=True, text=True, timeout=10)
        temp, *resto = [c.strip() for c in r.stdout.splitlines()[0].split(',')]
        return [int(temp), *resto]
    except (OSError, subprocess.TimeoutExpired, IndexError, ValueError):
        return [None] * 4


def avisar(nome, temp):
    atencao, critico = LIMITES[nome]
    agora = 2 if temp >= critico else 1 if temp >= atencao else 0
    if agora > nivel[nome]:
        nivel[nome] = agora
        urgencia = 'critical' if agora == 2 else 'normal'
        subprocess.run(['notify-send', '-u', urgencia, '-i', 'dialog-warning', f'{nome} a {temp} °C',
                        f'Limite de atenção {atencao} °C, crítico {critico} °C'], check=False)
        if agora == 2:
            subprocess.run(['paplay', ALARME], check=False)
    else:
        esfriou = 2 if temp > critico - FOLGA else 1 if temp > atencao - FOLGA else 0
        nivel[nome] = min(nivel[nome], esfriou)


def gravar(linha):
    PASTA.mkdir(parents=True, exist_ok=True)
    arquivo = PASTA / f'{datetime.now():%Y-%m}.csv'
    novo = not arquivo.exists()
    with arquivo.open('a', newline='') as f:
        saida = csv.writer(f)
        if novo:
            saida.writerow(COLUNAS)
        saida.writerow(linha)


def main():
    while True:
        cpu, placa = temp_processador(), dados_placa()
        gravar([f'{datetime.now():%Y-%m-%d %H:%M:%S}', cpu, *placa])
        for nome, temp in (('Processador', cpu), ('Placa de vídeo', placa[0])):
            if temp is not None:
                avisar(nome, temp)
        time.sleep(INTERVALO)


if __name__ == '__main__':
    main()
